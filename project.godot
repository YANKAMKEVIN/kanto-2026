; Kanto 2026 — configuration Godot 4.7

config_version=5

[application]

config/name="Kanto 2026"
config/description="Remake 2D personnel de Pokémon Rouge/Bleu, version smartphone 2026."
run/main_scene="res://game/boot.tscn"
config/icon="res://assets/ui/icon.png"
config/features=PackedStringArray("4.7", "Mobile")
config/quit_on_go_back=false
boot_splash/bg_color=Color(0.078431375, 0.0627451, 0.043137256, 1)
boot_splash/image="res://assets/ui/opening/splash_kanto_2026.png"
boot_splash/stretch_mode=1
boot_splash/use_filter=true

[autoload]

SceneRouter="*res://game/autoload/scene_router.gd"
GameState="*res://game/autoload/game_state.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1170
window/size/window_height_override=540
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[gui]

theme/custom="res://game/ui/theme/ui_theme.tres"

[input]

move_up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]
}
move_down={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69), Object(InputEventKey,"physical_keycode":32)]
}
run={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194325)]
}
menu={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194305), Object(InputEventKey,"physical_keycode":77)]
}

[input_devices]

pointing/emulate_touch_from_mouse=true

[layer_names]

2d_physics/layer_1="monde"
2d_physics/layer_2="joueur"
2d_physics/layer_3="pnj"
2d_physics/layer_4="interactifs"
2d_physics/layer_5="declencheurs"

[rendering]

renderer/rendering_method="mobile"
textures/canvas_textures/default_texture_filter=1
2d/snap/snap_2d_transforms_to_pixel=true
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.02, 0.03, 0.05, 1)

[shader_globals]

world_sun_dir={
"type": "vec2",
"value": Vector2(-0.7, -0.7)
}
world_rim_color={
"type": "color",
"value": Color(1, 1, 1, 1)
}
world_rim_strength={
"type": "float",
"value": 0.0
}
world_rim_width={
"type": "float",
"value": 0.0
}
world_wind={
"type": "float",
"value": 0.0
}
world_cast_shadow_color={
"type": "color",
"value": Color(0, 0, 0, 0)
}
world_contact_color={
"type": "color",
"value": Color(0, 0, 0, 0)
}
world_grade_shadows={
"type": "vec3",
"value": Vector3(1, 1, 1)
}
world_grade_midtones={
"type": "vec3",
"value": Vector3(1, 1, 1)
}
world_grade_highlights={
"type": "vec3",
"value": Vector3(1, 1, 1)
}
world_grade_strength={
"type": "float",
"value": 0.0
}
