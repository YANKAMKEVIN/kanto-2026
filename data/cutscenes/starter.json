{
	"starter_chosen": {
		"unless": ["rival_challenged"],
		"steps": [
			{ "move": "player", "to": { "near": "player", "offsets": [[0, 1]] },
				"keep_facing": true, "optional": true },
			{ "hop": "$player_starter",
				"to": { "near": "player",
					"offsets": [[1, 0], [-1, 0], [1, -1], [-1, -1], [1, 1], [-1, 1]] } },
			{ "face": "$player_starter", "to": "player" },
			{ "lean": "$player_starter", "to": "player" },
			{ "face": "player", "to": "$player_starter" },
			{ "wait": 0.8 },
			{ "face": "oak", "to": "player" },
			{ "dialogue": "oak_starter_reciprocal" },
			{ "set": ["starter_chosen"] },
			{ "face": "rival", "to": "$player_starter" },
			{ "wait": 0.6 },
			{ "face": "rival", "to": "$rival_starter" },
			{ "wait": 0.6 },
			{ "dialogue": "rival_starter_pick" },
			{ "hop": "$rival_starter", "to": { "near": "rival", "offsets": [[1, 0], [0, 1], [-1, 0]] } },
			{ "face": "rival", "to": "$rival_starter" },
			{ "face": "$rival_starter", "to": "rival" },
			{ "wait": 0.5 },
			{ "face": "rival", "to": "$player_starter" },
			{ "wait": 0.6 },
			{ "face": "rival", "to": "player" },
			{ "wait": 0.8 },
			{ "dialogue": "rival_starter_smile" },
			{ "wait": 0.4 },
			{ "move": "rival", "to": [7, 7], "follower": "$rival_starter" },
			{ "face": "$rival_starter", "to": "rival" },
			{ "wait": 0.3 },
			{ "face": "rival", "to": "player" },
			{ "dialogue": "rival_challenge_wait" },
			{ "face": "rival", "to": "$rival_starter" },
			{ "wait": 0.6 },
			{ "face": "rival", "to": "$player_starter" },
			{ "wait": 0.6 },
			{ "face": "rival", "to": "player" },
			{ "dialogue": "rival_challenge" },
			{ "battle": "rival_lab", "player_pokemon": "$player_starter",
				"foe_pokemon": "$rival_starter",
				"win": ["rival_lab_won"], "lose": ["rival_lab_lost"] },
			{ "set": ["rival_battle_done"] },
			{ "face": "rival", "to": "$rival_starter" },
			{ "despawn": "$rival_starter" },
			{ "wait": 0.8, "if": ["rival_lab_won"] },
			{ "dialogue": "rival_lab_won", "if": ["rival_lab_won"] },
			{ "move": "rival", "path": ["down"], "if": ["rival_lab_won"] },
			{ "dialogue": "rival_lab_won_leaving", "if": ["rival_lab_won"] },
			{ "face": "rival", "to": "player", "if": ["rival_lab_lost"] },
			{ "dialogue": "rival_lab_lost", "if": ["rival_lab_lost"] },
			{ "move": "rival", "to": [7, 9] },
			{ "despawn": "rival" },
			{ "set": ["rival_left_lab"] },
			{ "wait": 0.6 },
			{ "face": "oak", "to": "player" },
			{ "face": "player", "to": "oak" },
			{ "dialogue": "oak_after_battle" },
			{ "wait": 0.4 },
			{ "dialogue": "oak_poke_balls_intro" },
			{ "lean": "oak", "to": "player" },
			{ "give": "poke_ball", "count": 5 },
			{ "wait": 1.2 },
			{ "dialogue": "oak_poke_balls" },
			{ "face": "player", "to": "$player_starter" },
			{ "wait": 0.4 },
			{ "despawn": "$player_starter" },
			{ "set": ["rival_challenged"] }
		]
	},
	"oak_lab_exit": {
		"if": ["starter_offered"], "unless": ["starter_chosen"],
		"steps": [
			{ "face": "oak", "to": "player" },
			{ "dialogue": "oak_lab_exit_block" },
			{ "move": "player", "path": ["up"] }
		]
	}
}
